<Page x:Class="SteraLauncher.Pages.Check"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Checking" Background="#0F172A" Height="720" Width="1280">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Checking server status..." 
                       FontSize="24" FontWeight="Bold" Foreground="White" 
                       HorizontalAlignment="Center" TextAlignment="Center" />

            <Border Background="#1E293B" Padding="10" CornerRadius="8" Width="320">
                <ProgressBar IsIndeterminate="True" Width="300" Height="12" Foreground="#3B82F6" />
            </Border>
        </StackPanel>
    </Grid>
</Page>
