<Page x:Class="SteraLauncher.Pages.Library"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Library" Background="#0F172A" Height="720" Width="1280">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="10,5,10,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#151A26" Grid.Column="0" VerticalAlignment="Stretch">
            <StackPanel Margin="10">
                <TextBlock Text="Evoke OGFN" Foreground="White" FontSize="32" FontWeight="Bold" 
                           Margin="10" HorizontalAlignment="Center"/>

                <Button Content="Home" Click="HomeButton_Click"/>
                <Button Content="Library" Click="LibraryButton_Click" Background="#2563EB"/>
                <Button Content="Settings" Click="SettingsButton_Click"/>
                <Button Content="Discord Server" Background="#5865F2" Click="DiscordButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Height="500" Width="700" Background="#1E293B" Grid.Column="1">

            <!-- Sorting -->
            <TextBlock Text="Sort by: ▼ Version" Foreground="White" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Left" Margin="20,10,0,20"/>

            <!-- Download & Import Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Fortnite Build Section -->
                <Border Name="FortniteBuildContainer" Background="#111827" CornerRadius="10" Padding="10"
                        Height="200" Width="250" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Name="SplashImage" Width="150" Height="130" Stretch="UniformToFill" Visibility="Collapsed"/>
                        <TextBlock Name="FortniteBuildTextBlock" Text="Fortnite 6.21" 
                                   Foreground="White" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <TextBlock Name="FortniteVersionText" Text="6.21-CL-4526925" Foreground="Gray" FontSize="14"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Import Section -->
                <Border Background="#111827" CornerRadius="10" Padding="20" 
                        Height="200" Width="250" VerticalAlignment="Center" HorizontalAlignment="Left" MouseDown="SelectFolder_Click" Grid.Column="1" Margin="48,0,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="50" Height="50" Source="/Pages/import.png"/>
                        <TextBlock Text="Import" Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Add existing installation" Foreground="Gray" FontSize="14" 
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
