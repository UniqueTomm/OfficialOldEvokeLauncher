<Window x:Class="SteraLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evoke OGFN Launcher" Height="720" Width="1280"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#121826" Icon="/image.ico">
        
    <Grid>
        <!-- Custom Title Bar -->
        <DockPanel Background="#151A26" Height="40" VerticalAlignment="Top" MouseDown="TitleBar_MouseDown">
            <TextBlock Text="Evoke OGFN Launcher" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Minimize Button -->
                <Button Content="➖" Click="Minimize_Click"
                        Background="Transparent" Foreground="White" 
                        Width="40" Height="40" FontSize="18"
                        BorderThickness="0" Cursor="Hand"/>

                <!-- Close Button -->
                <Button Content="✖" Click="Close_Click"
                        Background="Transparent" Foreground="White"
                        Width="40" Height="40" FontSize="18"
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>

        <!-- Page Content -->
        <Frame Name="MainFrame" NavigationUIVisibility="Hidden" Margin="0,40,0,0"/>
    </Grid>
</Window>
